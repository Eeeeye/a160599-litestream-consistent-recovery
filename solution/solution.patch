diff --git dst/follow_commit.go dst/follow_commit.go
new file mode 100644
index 0000000..c045ef5
--- /dev/null
+++ dst/follow_commit.go
@@ -0,0 +1,262 @@
+package litestream
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+
+	"github.com/superfly/ltx"
+
+	"github.com/benbjohnson/litestream/internal"
+)
+
+const followCommitRecordVersion = 1
+
+type followCommitRecord struct {
+	Version   int    `json:"version"`
+	FromTXID  string `json:"from_txid"`
+	ToTXID    string `json:"to_txid"`
+	Stage     string `json:"stage"`
+	OldSize   int64  `json:"old_size"`
+	OldSHA256 string `json:"old_sha256"`
+	NewSize   int64  `json:"new_size"`
+	NewSHA256 string `json:"new_sha256"`
+}
+
+var restorePathMutexes sync.Map
+
+func lockRestorePath(path string) func() {
+	absPath, err := filepath.Abs(path)
+	if err != nil {
+		absPath = filepath.Clean(path)
+	}
+	v, _ := restorePathMutexes.LoadOrStore(absPath, &sync.Mutex{})
+	mu := v.(*sync.Mutex)
+	mu.Lock()
+	return mu.Unlock
+}
+
+func followCommitPath(outputPath string) string { return outputPath + "-follow" }
+
+// commitFollowStaged durably publishes a staged database and its TXID. Since
+// two pathnames cannot be renamed atomically, a checksummed intent record lets
+// a later invocation distinguish an old generation from a published generation
+// whose TXID sidecar was not yet updated.
+func commitFollowStaged(outputPath, stagePath string, fromTXID, toTXID ltx.TXID) error {
+	if toTXID <= fromTXID {
+		return fmt.Errorf("invalid follow commit range: %s..%s", fromTXID, toTXID)
+	}
+
+	newSize, newSHA, err := fileIdentity(stagePath)
+	if err != nil {
+		return fmt.Errorf("identify staged follower: %w", err)
+	}
+
+	record := followCommitRecord{
+		Version:   followCommitRecordVersion,
+		FromTXID:  fromTXID.String(),
+		ToTXID:    toTXID.String(),
+		Stage:     filepath.Base(stagePath),
+		OldSize:   -1,
+		NewSize:   newSize,
+		NewSHA256: newSHA,
+	}
+	if _, statErr := os.Stat(outputPath); statErr == nil {
+		record.OldSize, record.OldSHA256, err = fileIdentity(outputPath)
+		if err != nil {
+			return fmt.Errorf("identify current follower: %w", err)
+		}
+	} else if !errors.Is(statErr, os.ErrNotExist) {
+		return fmt.Errorf("stat current follower: %w", statErr)
+	} else if fromTXID != 0 {
+		return fmt.Errorf("current follower missing for commit from txid %s", fromTXID)
+	}
+
+	if fromTXID != 0 {
+		currentTXID, err := ReadTXIDFile(outputPath)
+		if err != nil {
+			return err
+		}
+		if currentTXID != fromTXID {
+			return fmt.Errorf("stale follow commit: sidecar txid=%s, expected %s", currentTXID, fromTXID)
+		}
+	}
+
+	if err := writeFollowCommitRecord(outputPath, record); err != nil {
+		return err
+	}
+	if err := os.Rename(stagePath, outputPath); err != nil {
+		_ = removeFollowCommitRecord(outputPath)
+		return fmt.Errorf("publish follower generation: %w", err)
+	}
+	if err := internal.FsyncDir(filepath.Dir(outputPath)); err != nil {
+		return fmt.Errorf("sync follower directory after publish: %w", err)
+	}
+	if err := WriteTXIDFile(outputPath, toTXID); err != nil {
+		return fmt.Errorf("publish follower txid: %w", err)
+	}
+	if err := removeFollowCommitRecord(outputPath); err != nil {
+		return err
+	}
+	return nil
+}
+
+// recoverFollowCommit reconciles an interrupted database/TXID publication.
+// It rolls forward only when the visible database matches the recorded new
+// identity, rolls back an unpublished stage when the old identity is visible,
+// and otherwise fails closed.
+func recoverFollowCommit(outputPath string) (ltx.TXID, error) {
+	record, err := readFollowCommitRecord(outputPath)
+	if errors.Is(err, os.ErrNotExist) {
+		return ReadTXIDFile(outputPath)
+	} else if err != nil {
+		return 0, err
+	}
+
+	fromTXID, err := ltx.ParseTXID(record.FromTXID)
+	if err != nil {
+		return 0, fmt.Errorf("parse follow record from txid: %w", err)
+	}
+	toTXID, err := ltx.ParseTXID(record.ToTXID)
+	if err != nil {
+		return 0, fmt.Errorf("parse follow record to txid: %w", err)
+	}
+	if toTXID <= fromTXID {
+		return 0, fmt.Errorf("invalid follow record range: %s..%s", fromTXID, toTXID)
+	}
+
+	stagePath, err := followStagePath(outputPath, record.Stage)
+	if err != nil {
+		return 0, err
+	}
+	currentTXID, err := ReadTXIDFile(outputPath)
+	if err != nil {
+		return 0, err
+	}
+
+	visibleSize, visibleSHA, identityErr := fileIdentity(outputPath)
+	if identityErr == nil && visibleSize == record.NewSize && visibleSHA == record.NewSHA256 {
+		if currentTXID != fromTXID && currentTXID != toTXID {
+			return 0, fmt.Errorf("follow recovery sidecar txid=%s, expected %s or %s", currentTXID, fromTXID, toTXID)
+		}
+		if currentTXID != toTXID {
+			if err := WriteTXIDFile(outputPath, toTXID); err != nil {
+				return 0, fmt.Errorf("roll forward follower txid: %w", err)
+			}
+		}
+		_ = os.Remove(stagePath)
+		if err := removeFollowCommitRecord(outputPath); err != nil {
+			return 0, err
+		}
+		return toTXID, nil
+	}
+
+	oldVisible := identityErr == nil && record.OldSize >= 0 && visibleSize == record.OldSize && visibleSHA == record.OldSHA256
+	initialUnpublished := errors.Is(identityErr, os.ErrNotExist) && fromTXID == 0 && currentTXID == 0
+	if oldVisible || initialUnpublished {
+		if currentTXID != fromTXID {
+			return 0, fmt.Errorf("follow recovery old generation has sidecar txid=%s, expected %s", currentTXID, fromTXID)
+		}
+		_ = os.Remove(stagePath)
+		if err := removeFollowCommitRecord(outputPath); err != nil {
+			return 0, err
+		}
+		return fromTXID, nil
+	}
+
+	if identityErr != nil && !errors.Is(identityErr, os.ErrNotExist) {
+		return 0, fmt.Errorf("identify follower during recovery: %w", identityErr)
+	}
+	return 0, fmt.Errorf("cannot reconcile follow commit: visible database matches neither txid %s nor %s generation", fromTXID, toTXID)
+}
+
+func writeFollowCommitRecord(outputPath string, record followCommitRecord) error {
+	dir := filepath.Dir(outputPath)
+	tmp, err := os.CreateTemp(dir, "."+filepath.Base(outputPath)+"-follow-record-*")
+	if err != nil {
+		return fmt.Errorf("create follow record: %w", err)
+	}
+	tmpPath := tmp.Name()
+	defer func() {
+		_ = tmp.Close()
+		_ = os.Remove(tmpPath)
+	}()
+
+	enc := json.NewEncoder(tmp)
+	enc.SetEscapeHTML(false)
+	if err := enc.Encode(record); err != nil {
+		return fmt.Errorf("encode follow record: %w", err)
+	}
+	if err := tmp.Sync(); err != nil {
+		return fmt.Errorf("sync follow record: %w", err)
+	}
+	if err := tmp.Close(); err != nil {
+		return fmt.Errorf("close follow record: %w", err)
+	}
+	if err := os.Rename(tmpPath, followCommitPath(outputPath)); err != nil {
+		return fmt.Errorf("publish follow record: %w", err)
+	}
+	if err := internal.FsyncDir(dir); err != nil {
+		return fmt.Errorf("sync follow record directory: %w", err)
+	}
+	return nil
+}
+
+func readFollowCommitRecord(outputPath string) (followCommitRecord, error) {
+	var record followCommitRecord
+	data, err := os.ReadFile(followCommitPath(outputPath))
+	if err != nil {
+		return record, err
+	}
+	if err := json.Unmarshal(data, &record); err != nil {
+		return record, fmt.Errorf("decode follow record: %w", err)
+	}
+	if record.Version != followCommitRecordVersion {
+		return record, fmt.Errorf("unsupported follow record version: %d", record.Version)
+	}
+	if record.NewSize < 0 || len(record.NewSHA256) != sha256.Size*2 {
+		return record, fmt.Errorf("invalid follow record new identity")
+	}
+	return record, nil
+}
+
+func removeFollowCommitRecord(outputPath string) error {
+	if err := os.Remove(followCommitPath(outputPath)); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return fmt.Errorf("remove follow record: %w", err)
+	}
+	if err := internal.FsyncDir(filepath.Dir(outputPath)); err != nil {
+		return fmt.Errorf("sync follower directory after record removal: %w", err)
+	}
+	return nil
+}
+
+func followStagePath(outputPath, name string) (string, error) {
+	base := "." + filepath.Base(outputPath)
+	validPrefix := strings.HasPrefix(name, base+"-follow-") || strings.HasPrefix(name, base+"-restore-")
+	if name == "" || filepath.Base(name) != name || !validPrefix {
+		return "", fmt.Errorf("invalid follow record staging name %q", name)
+	}
+	return filepath.Join(filepath.Dir(outputPath), name), nil
+}
+
+func fileIdentity(path string) (int64, string, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return 0, "", err
+	}
+	defer f.Close()
+
+	h := sha256.New()
+	n, err := io.Copy(h, f)
+	if err != nil {
+		return 0, "", err
+	}
+	return n, hex.EncodeToString(h.Sum(nil)), nil
+}
