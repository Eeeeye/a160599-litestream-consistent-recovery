--- src/internal/internal.go
+++ dst/internal/internal.go
@@ -96,0 +97,13 @@ func CreateFile(filename string, fi os.FileInfo) (*os.File, error) {
+// FsyncDir persists directory-entry changes made by rename or remove.
+func FsyncDir(path string) error {
+	dir, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	if err := dir.Sync(); err != nil {
+		_ = dir.Close()
+		return err
+	}
+	return dir.Close()
+}
